{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Buzi",
  "version": "0.0.0",
  "identifier": "ai.opencode.buzi",
  "build": {
    "beforeDevCommand": "bun run build-sidecar && bun run dev",
    "beforeBuildCommand": "bun run build-sidecar && bun run build",
    "devUrl": "http://localhost:4455",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Buzi",
        "width": 1280,
        "height": 840,
        "minWidth": 360,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "externalBin": [
      "binaries/opencode"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
