{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode-ai/buzi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4455",
    "dev:linux": "VITE_BUZI_NATIVE_HEADERBAR=1 vite --host 0.0.0.0 --port 4455",
    "build": "tsc -b && vite build",
    "build-sidecar": "bun run scripts/build-opencode-sidecar.ts",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:linux": "tauri build --bundles deb,rpm,appimage",
    "desktop:build:mac": "tauri build --bundles dmg,app",
    "desktop:build:win": "tauri build --bundles nsis,msi",
    "gtk:check": "cargo check --manifest-path src-gtk/Cargo.toml",
    "gtk:dev": "bun run src-gtk/scripts/dev.ts",
    "gtk:run": "cargo run --manifest-path src-gtk/Cargo.toml",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.15.10",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@tailwindcss/vite": "4.1.11",
    "@tanstack/react-query": "5.99.2",
    "@tauri-apps/api": "2.11.0",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.1.11",
    "virtua": "catalog:",
    "vite": "7.1.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.2",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.8.2"
  }
}
